# ── Supabase ────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chiachat-media

# ── Stripe ──────────────────────────────────────────────────────
# Dashboard → Developers → API keys / Webhooks / Payment Links
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PAYMENT_LINK=https://buy.stripe.com/...

# ── OpenAI ──────────────────────────────────────────────────────
# Used for everything text + STT: Chia's chat replies, lesson
# formatting, voice-note pronunciation analysis, Whisper transcription,
# memory extraction. GPT-4o-mini is the default model — extremely cheap.
OPENAI_API_KEY=sk-...

# ── ElevenLabs ──────────────────────────────────────────────────
# API key for outbound TTS (Chia speaking a target phrase) and
# Conversational Agent invocation (voice-note correction loop).
ELEVENLABS_API_KEY=
ELEVENLABS_CHIA_VOICE_ID=
# Conversational Agent ID (ElevenLabs dashboard → Agents). Posts
# back to /api/webhooks/elevenlabs after each voice exchange.
ELEVENLABS_AGENT_ID=
# Shared secret used to verify post-call webhooks from the agent.
ELEVENLABS_WEBHOOK_SECRET=

# ── Meta WhatsApp Cloud API ─────────────────────────────────────
# All five values come from the Meta App dashboard at
# https://developers.facebook.com/apps/<app-id>/whatsapp-business/wa-settings
#
# Long-lived system user access token (NOT the temporary 24h token).
# Generate via Business Settings → System users → Generate token,
# permissions: whatsapp_business_messaging, whatsapp_business_management.
META_WHATSAPP_ACCESS_TOKEN=
# Numeric ID for the phone number — used in API URL paths.
META_WHATSAPP_PHONE_NUMBER_ID=
# Numeric ID for the WhatsApp Business Account that owns the number.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Random string you choose. Meta calls your webhook with
# ?hub.verify_token=...&hub.challenge=... once at setup; the webhook
# echoes the challenge back if this token matches.
META_WHATSAPP_VERIFY_TOKEN=
# Meta App secret — used to verify the X-Hub-Signature-256 header
# on every inbound webhook (HMAC-SHA256 of the raw body).
META_WHATSAPP_APP_SECRET=
# The actual phone number in E.164 format (display only, not for auth).
META_WHATSAPP_NUMBER=

# ── Vercel Cron ─────────────────────────────────────────────────
# Auto-generated by Vercel when you set up cron jobs. Do not invent.
# vercel env pull will fetch it locally; in Vercel UI it's named
# CRON_SECRET. Used to authenticate hourly reminder + memory updater
# cron invocations.
CRON_SECRET=

# ── Admin ───────────────────────────────────────────────────────
# The single email allowed to sign in to /admin.
ADMIN_EMAIL=admin@example.com
