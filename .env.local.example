# ── Supabase ────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chiachat-media

# ── Stripe ──────────────────────────────────────────────────────
# Dashboard → Developers → API keys / Webhooks / Payment Links
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PAYMENT_LINK=https://buy.stripe.com/...

# ── OpenAI (used by Make.com scenarios, not the Next.js app) ────
OPENAI_API_KEY=sk-...

# ── ElevenLabs ──────────────────────────────────────────────────
# API key used by Make.com for outbound TTS (Chia speaks a phrase
# unprompted). The voice loop for student voice-note correction is
# handled by the ElevenLabs Conversational Agent natively over
# WhatsApp — see README "ElevenLabs setup" section.
ELEVENLABS_API_KEY=
ELEVENLABS_CHIA_VOICE_ID=
# Conversational Agent ID (ElevenLabs dashboard → Agents). The
# agent owns the WhatsApp audio integration and posts back to
# /api/webhooks/elevenlabs after each voice exchange.
ELEVENLABS_AGENT_ID=
# Shared secret used to verify webhook calls from the ElevenLabs
# agent to /api/webhooks/elevenlabs. Generate any random string.
ELEVENLABS_WEBHOOK_SECRET=

# ── Meta WhatsApp Cloud API ─────────────────────────────────────
# Used by Make.com scenarios for inbound webhook + outbound sends,
# and by the ElevenLabs Conversational Agent for the voice loop.
# All five values come from the Meta App dashboard at
# https://developers.facebook.com/apps/<app-id>/whatsapp-business/wa-settings
#
# Long-lived system user access token (NOT the temporary 24h token).
# Generate via Business Settings → System users → Generate token,
# permissions: whatsapp_business_messaging, whatsapp_business_management.
META_WHATSAPP_ACCESS_TOKEN=
# Numeric ID for the phone number — used in API URL paths, e.g.
# https://graph.facebook.com/v21.0/{PHONE_NUMBER_ID}/messages
META_WHATSAPP_PHONE_NUMBER_ID=
# Numeric ID for the WhatsApp Business Account that owns the number.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Random string you choose. Meta calls your webhook with
# ?hub.verify_token=...&hub.challenge=... once at setup; the webhook
# echoes the challenge back if this token matches.
META_WHATSAPP_VERIFY_TOKEN=
# Meta App secret — used to verify the X-Hub-Signature-256 header
# on every inbound webhook (HMAC-SHA256 of the raw body).
META_WHATSAPP_APP_SECRET=
# The actual phone number in E.164 format (display only, not for auth).
META_WHATSAPP_NUMBER=

# ── Make.com webhooks (called from Next.js → Make) ──────────────
# Webhook URL of the Make scenario that sends Chia's reactivation
# message after a successful Stripe upgrade. Empty = skip the relay.
MAKE_STRIPE_REACTIVATION_WEBHOOK_URL=
# Webhook URL of Make scenario 1 (inbound text router). Meta sends
# inbound messages to /api/webhooks/whatsapp on this app, which
# verifies and forwards here. Get this URL from Make after creating
# the scenario's webhook trigger.
MAKE_WHATSAPP_WEBHOOK_URL=

# ── Admin ───────────────────────────────────────────────────────
# The single email allowed to sign in to /admin (any address that
# exists in Supabase Auth + matches this value will be allowed).
ADMIN_EMAIL=admin@example.com
