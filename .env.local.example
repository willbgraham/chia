# ── Supabase ────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chiachat-media

# ── Stripe ──────────────────────────────────────────────────────
# Dashboard → Developers → API keys / Webhooks / Payment Links
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PAYMENT_LINK=https://buy.stripe.com/...
# Annual €200/year Payment Link (optional but recommended — yearly
# converts better with motivated learners). Create as a separate
# Payment Link in Stripe with a yearly-recurring €200 price. Leave
# blank to hide the annual option on /upgrade entirely.
STRIPE_PREMIUM_ANNUAL_PAYMENT_LINK=
# Promo code to pre-fill at Stripe checkout when students click the
# upgrade button. Requires "Allow promotion codes" to be enabled on
# the Payment Link in the Stripe dashboard. Leave unset for no
# auto-discount (students can still manually enter a code). Per-link
# overrides are possible by passing ?promo=CODE on /upgrade.
STRIPE_PREFILLED_PROMO_CODE=

# ── OpenAI ──────────────────────────────────────────────────────
# Used for everything text + STT: Chia's chat replies, lesson
# formatting, voice-note pronunciation analysis, Whisper transcription,
# memory extraction. GPT-4o-mini is the default model — extremely cheap.
OPENAI_API_KEY=sk-...

# ── Per-user daily text-message throttle ────────────────────────
# Soft caps inbound text messages per UTC day per user, bounding
# OpenAI spend if someone goes wild. Onboarding is exempt.
# Defaults if unset: free=50, premium=500.
FREE_DAILY_TEXT_LIMIT=50
PREMIUM_DAILY_TEXT_LIMIT=500

# ── ElevenLabs ──────────────────────────────────────────────────
# API key for outbound TTS (Chia speaking a target phrase) and
# Conversational Agent invocation (voice-note correction loop).
ELEVENLABS_API_KEY=
ELEVENLABS_CHIA_VOICE_ID=
# Conversational Agent ID (ElevenLabs dashboard → Agents). Posts
# back to /api/webhooks/elevenlabs after each voice exchange.
ELEVENLABS_AGENT_ID=
# Shared secret used to verify post-call webhooks from the agent.
ELEVENLABS_WEBHOOK_SECRET=

# ── Meta WhatsApp Cloud API ─────────────────────────────────────
# All five values come from the Meta App dashboard at
# https://developers.facebook.com/apps/<app-id>/whatsapp-business/wa-settings
#
# Long-lived system user access token (NOT the temporary 24h token).
# Generate via Business Settings → System users → Generate token,
# permissions: whatsapp_business_messaging, whatsapp_business_management.
META_WHATSAPP_ACCESS_TOKEN=
# Numeric ID for the phone number — used in API URL paths.
META_WHATSAPP_PHONE_NUMBER_ID=
# Numeric ID for the WhatsApp Business Account that owns the number.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Random string you choose. Meta calls your webhook with
# ?hub.verify_token=...&hub.challenge=... once at setup; the webhook
# echoes the challenge back if this token matches.
META_WHATSAPP_VERIFY_TOKEN=
# Meta App secret — used to verify the X-Hub-Signature-256 header
# on every inbound webhook (HMAC-SHA256 of the raw body).
META_WHATSAPP_APP_SECRET=
# The actual phone number in E.164 format (display only, not for auth).
META_WHATSAPP_NUMBER=

# Public-facing WhatsApp number for the homepage CTA (no leading +).
# Falls back to the +43 production number if unset. Useful if you want
# to point chiachat.com at a different number (test sandbox, etc.).
NEXT_PUBLIC_CHIA_WHATSAPP_NUMBER=436606412569

# Base URL for student-facing account magic links. Defaults to
# https://chiachat.com if unset. Set to localhost or a Vercel preview
# URL when developing.
NEXT_PUBLIC_APP_URL=https://chiachat.com

# ── Student account self-service ────────────────────────────────
# HMAC secret for signing /account/<token> magic links Chia sends in
# WhatsApp. Use a random ≥32-char string. Rotating this invalidates
# all outstanding links (students just message Chia "account" for a
# fresh one). Generate with: openssl rand -base64 48
MAGIC_LINK_SECRET=replace-with-32-or-more-random-characters
# Email address shown to students when they hit "Contact support"
# on /account/<token>. Should be a real inbox you check.
SUPPORT_EMAIL=support@chiachat.com

# ── Meta Pixel ──────────────────────────────────────────────────
# Pixel ID from Meta Events Manager. Auto-fires PageView on every
# route load and Lead on every WhatsApp CTA click. Optional —
# leave unset on dev / preview deployments to skip the network
# ping. Find your ID at business.facebook.com/events_manager.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Vercel Cron ─────────────────────────────────────────────────
# Auto-generated by Vercel when you set up cron jobs. Do not invent.
# vercel env pull will fetch it locally; in Vercel UI it's named
# CRON_SECRET. Used to authenticate hourly reminder + memory updater
# cron invocations.
CRON_SECRET=

# ── Admin ───────────────────────────────────────────────────────
# The single email allowed to sign in to /admin.
ADMIN_EMAIL=admin@example.com
